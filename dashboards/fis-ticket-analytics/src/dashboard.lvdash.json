{
  "datasets": [
    {
      "name": "datasets/fis_ticket_analytics",
      "displayName": "FIS Ticket Analytics",
      "metricViewConfig": "version: '1.1'\nsource: serverless_stable_l26d62_catalog.fis_knowledge_agent.rd_tasks_gold_analytics\ndimensions:\n  - name: task_number\n    expr: task_number\n    comment: R&D task ID\n  - name: title\n    expr: title\n    comment: Short description of the task/issue\n  - name: priority_label\n    expr: priority_label\n    comment: \"Text priority: Critical/High/Moderate/Low\"\n  - name: status\n    expr: status\n    comment: \"Open, Pending, Closed Complete, Closed Skipped, Closed Incomplete\"\n  - name: workflow_status\n    expr: workflow_status\n    comment: \"Draft, Assigned, Work in progress, Completed\"\n  - name: is_closed\n    expr: is_closed\n    comment: TRUE if status starts with Closed\n  - name: assigned_to\n    expr: assigned_to\n    comment: R&D team member who owns the task\n  - name: location_state\n    expr: location_state\n    comment: 2-letter US state / Canadian province\n  - name: location_site\n    expr: location_site\n    comment: Site name\n  - name: problem_category\n    expr: problem_category\n    comment: \"hardware_failure, software_crash, network_connectivity, calibration, etc.\"\n  - name: resolution_type\n    expr: resolution_type\n    comment: \"hardware_replace, software_patch, recalibration, config_change, etc.\"\n  - name: needs_review\n    expr: needs_review\n    comment: TRUE if enrichment confidence was low\nmeasures:\n  - name: ticket_count\n    expr: COUNT(1)\n    comment: Total number of tickets\n  - name: avg_duration_days\n    expr: AVG(duration_days)\n    comment: Average days to resolve\n    format:\n      type: number\n      decimal_places:\n        type: exact\n        places: 1\n  - name: open_tickets\n    expr: COUNT(1) FILTER (WHERE is_closed = false)\n    comment: Number of open tickets\n  - name: closed_tickets\n    expr: COUNT(1) FILTER (WHERE is_closed = true)\n    comment: Number of closed tickets\n"
    }
  ],
